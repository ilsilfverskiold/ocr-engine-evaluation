# Secrets
.env

# Document images live on HuggingFace; reference sidecars ship in Git.
# (https://huggingface.co/datasets/ilsilfverskiold/ocr-benchmark).
# Fetch with: python scripts/download_data.py
# Corpus metadata and scoring references are committed.
documents/*
!documents/manifest.json
!documents/gt_limitations.json
!documents/gt_provenance.json
!documents/schema_fields.json
!documents/schema_sample.json
!documents/easy/
!documents/medium/
!documents/hard/
documents/easy/**/*
documents/medium/**/*
documents/hard/**/*
!documents/easy/**/
!documents/medium/**/
!documents/hard/**/
!documents/**/*_gt.txt
!documents/**/*_gt.json
!documents/**/*_gt.md

# Accepted references are part of the reproducible evaluation. Images, draft
# proposals, editor exports and save history remain local corpus artifacts.
!documents/table_references/
documents/table_references/*
!documents/table_references/gold/
documents/table_references/gold/*
!documents/table_references/gold/*.json
!documents/table_references/old/
documents/table_references/old/*
!documents/table_references/old/shipping_*.json
!documents/structured_references/
documents/structured_references/*
!documents/structured_references/kv_label_review.json
!documents/structured_references/gold/
documents/structured_references/gold/*
!documents/structured_references/gold/*.json

# Published evidence lives in one verified bundle. Working runs and exports
# are local; publish_results.py replaces the bundle after an offline rescore.
results/*
!results/current.zip

# Python
__pycache__/
*.py[co]
.venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Modal local state
.modal/

# Test cache
.pytest_cache/

# Local browser exports
results/reports/
