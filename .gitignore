# Secrets
.env

# Document images live on HuggingFace; reference sidecars ship in Git.
# (https://huggingface.co/datasets/ilsilfverskiold/ocr-benchmark).
# Fetch with: python scripts/download_data.py
# Corpus metadata and scoring references are committed.
documents/*
!documents/manifest.json
!documents/gt_limitations.json
!documents/gt_provenance.json
!documents/schema_fields.json
!documents/schema_sample.json
!documents/easy/
!documents/medium/
!documents/hard/
documents/easy/**/*
documents/medium/**/*
documents/hard/**/*
!documents/easy/**/
!documents/medium/**/
!documents/hard/**/
!documents/**/*_gt.txt
!documents/**/*_gt.json
!documents/**/*_gt.md

# Accepted references are part of the reproducible evaluation. Images, draft
# proposals, editor exports and save history remain local corpus artifacts.
!documents/table_references/
documents/table_references/*
!documents/table_references/gold/
documents/table_references/gold/*
!documents/table_references/gold/*.json
!documents/table_references/old/
documents/table_references/old/*
!documents/table_references/old/shipping_*.json
!documents/structured_references/
documents/structured_references/*
!documents/structured_references/kv_label_review.json
!documents/structured_references/gold/
documents/structured_references/gold/*
!documents/structured_references/gold/*.json

# Published results are committed as inspectable files. Superseded working
# results are removed before publication.
results/*
!results/ocr_outputs/
!results/ocr_outputs/**
!results/runs/
!results/runs/**
!results/logs/
results/logs/**
!results/summaries/
!results/summaries/**
results/reports/**
!results/judge_checklists/
!results/judge_checklists/**
!results/kv_synonyms/
!results/kv_synonyms/**
# Full KV judge requests/replies stay local; the rulings live in the page files.
results/kv_synonyms/value_assisted/calls/
!results/markdown_judge_cache/
!results/markdown_judge_cache/**

# Python
__pycache__/
*.py[co]
.venv/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/

# Modal local state
.modal/

# Test cache
.pytest_cache/

# Docs
/docs

# Development tooling: used while building and checking the benchmark,
# not needed to run it.
/tests/
/scripts/backfill_complete_views.py
/scripts/backfill_docling_views.py
/scripts/build_evidence_report.py
/scripts/build_result_diff.py
/scripts/build_schema_validation_report.py
/scripts/comparison_report.py
/scripts/repair_reconciled_sources.py
/scripts/verify_published_replay.py
