# Copy this file to .env and fill in only the keys for the engines you plan to run.
# EVERY variable here is optional: engines whose keys are missing are simply not
# selectable (`--check` will show them as [MISSING]), and the LLM judge can be
# disabled with --skip-judge. The free local engines (tesseract, docling) need
# no keys at all.

# --- AWS Textract (engines: textract_text, textract_structured) ---------------
# IAM user with AmazonTextractFullAccess. See README "API keys" section.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Mistral (engine: mistral_ocr) --------------------------------------------
# console.mistral.ai -> API Keys
MISTRAL_API_KEY=

# --- LlamaParse (engine: llamaparse) ------------------------------------------
# cloud.llamaindex.ai -> API Keys. Free tier: 1,000 pages/day.
LLAMA_CLOUD_API_KEY=

# --- Google (engine: gemini_flash AND the LLM judge) --------------------------
# aistudio.google.com -> Get API key.
# NOTE: the LLM judge (Gemini 2.5 Pro) uses this key too. Without it, run with
# --skip-judge.
GOOGLE_API_KEY=

# --- Anthropic (engine: claude_sonnet_4_6) ------------------------------------
# console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- HuggingFace (corpus re-download + Modal model weights) -------------------
# huggingface.co -> Settings -> Access Tokens (a read token is enough).
# Needed to download the benchmark data (scripts/download_data.py) or deploy
# the self-hosted Modal engines (scripts/setup_modal.py copies it into a Modal
# secret so containers can pull model weights).
HF_TOKEN=
