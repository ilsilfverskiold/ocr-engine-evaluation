  "dataset_offset": 24,
  "doc_type": "shipping",
  "note": "The getomni schema extracts only the single most recent shipment out of the eight printed on this photographed FedEx fiscal invoice, and for that one shipment it keeps only the charge amounts, dropping the VAT/Code and Gross Value columns. That leaves roughly seven eighths of the page untested. Extended with the invoice header block (title, carrier, document number, page) and a full 'shipments' array: one object per printed table row, each carrying shipment number, reference number, date, both parties split into company/address/city/zipCode, service type, weight, shipment count, base charge, and every additional-charge line with all three of its columns. The dataset's own 'issueDate', 'clientNumber' and 'mostRecentShipment' object are preserved byte-for-byte; 'shipments[7]' is the same shipment seen in full. Every added value corroborated against the 14 saved engine outputs (most at 10-14/14). Judgement calls: (1) 'documentNumber' is recorded as '7JEZYO7MSY' per the dataset's own text annotation; at this photo resolution the sixth glyph is not separable as letter O from digit 0 and engines split roughly evenly between the two, so it is a legitimately hard field rather than an unverified one. (2) Reference number is blank for five rows and recorded as null there, matching how the dataset itself handles the field. (3) 'Rosenbaum, Boehm And Franey' and 'Mcclure, Blick And Frami' fall below the one-third engine threshold as whole strings only because most engines break them at the cell line wrap; both are clearly legible on the page and present in the dataset text sidecar, and the second is the dataset's own recipient value.",
  "extended_annotator": "claude-opus-5",
  "field_provenance": {
    "dataset_human": ["issueDate", "clientNumber", "mostRecentShipment"],
    "model_verified": ["title", "carrier", "documentNumber", "page", "shipments"]
  },
  "json_schema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "description": "Document title as printed" },
      "carrier": { "type": "string", "description": "Carrier whose logo appears on the invoice" },
      "documentNumber": { "type": "string", "description": "Unique identifier for the invoice" },
      "clientNumber": { "type": "string", "description": "Unique identifier for the client" },
      "issueDate": { "type": "string", "description": "Date the invoice was issued" },
      "page": { "type": "string", "description": "Page indicator as printed in the header block" },
      "shipments": {
        "type": "array",
        "description": "Every shipment row printed in the table, in page order",
        "items": {
          "type": "object",
          "required": ["shipmentNumber"],
          "properties": {
            "shipmentNumber": { "type": "string" },
            "referenceNumber": { "type": ["string", "null"], "description": "Sender / reference number, null when the cell is blank" },
            "date": { "type": "string" },
            "sender": {
              "type": "object",
              "properties": {
                "company": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "zipCode": { "type": "string" }
              }
            },
            "recipient": {
              "type": "object",
              "properties": {
                "company": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "zipCode": { "type": "string" }
              }
            },
            "typeOfService": { "type": "string" },
            "weightInKg": { "type": "number" },
            "numberOfShipments": { "type": "number" },
            "baseCharge": { "type": "number" },
            "additionalCharges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": { "type": "string" },
                  "amount": { "type": "number" },
                  "vat": { "type": "number", "description": "Value from the VAT / Code column" },
                  "grossValue": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "mostRecentShipment": {
        "type": "object",
        "required": ["shipmentNumber"],
        "description": "Shipment with the most recent date (closest to today's date), always the last item in the list",
        "properties": {
          "sender": {
            "type": "object",
            "required": ["company"],
            "properties": {
              "city": { "type": "string", "description": "City of the sender as it appears, excluding zip code" },
              "address": { "type": "string", "description": "Street address of the sender as it appears, only including number and street" },
              "company": { "type": "string", "description": "Sender's company name as it appears" },
              "zipCode": { "type": "string", "description": "Zip code of the sender as it appears" }
            }
          },
          "recipient": {
            "type": "object",
            "required": ["company"],
            "properties": {
              "address": { "type": "string", "description": "Street address of the recipient as it appears, only including number and street" },
              "company": { "type": "string", "description": "Recipient's company name as it appears" }
            }
          },
          "weightInKg": { "type": "number", "description": "Weight of the shipment in kilograms" },
          "shipmentNumber": { "type": "string", "description": "Unique identifier for the shipment" },
          "referenceNumber": { "type": "string", "description": "Reference number for the shipment, must return null if not provided" },
          "additionalCharges": {
            "type": "array",
            "description": "Details of additional charges applied to the shipment",
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "amount": { "type": "number", "description": "Amount of the additional charge" },
                "description": { "type": "string", "description": "Description of the additional charge as it appears" }
              }
            }
          }
        }
      }
    }
  },
