  "doc_type": "shipping",
  "note": "The getomni schema takes the three header identifiers plus one shipment out of the eight printed, and for that shipment it drops the base charge, service type, weight and shipment count. Extended with the full header (title, carrier, page) and a 'shipments' array carrying one object per printed row with every column of the table, including each additional-charge line's amount, VAT/Code and gross value. The dataset's 'issueDate', 'clientNumber', 'documentNumber' and 'mostRecentShipment' are preserved unchanged; 'shipments[7]' is that shipment in full. All added values corroborated by the 14 saved engine outputs. Judgement calls: (1) reference number is blank on three rows and recorded as null; (2) values are recorded exactly as printed, so the gross value 32 and the weights 35 and 28 stay without decimals while sibling cells carry two; (3) 'PORT WYATTFORT, 27397' sits marginally under the one-third corroboration threshold (4 of 14) purely because most engines wrap that cell, and it is unambiguous on the page; (4) party names are printed in upper case in this render and are kept in upper case, matching the dataset's own values for the same fields.",
  "extended_annotator": "claude-opus-5",
  "field_provenance": {
    "dataset_human": ["issueDate", "clientNumber", "documentNumber", "mostRecentShipment"],
    "model_verified": ["title", "carrier", "page", "pageFooter", "shipments"]
  },
  "json_schema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "description": "Document title as printed" },
      "carrier": { "type": "string", "description": "Carrier named in the letterhead logo" },
      "documentNumber": { "type": "string", "description": "Unique identifier for the invoice" },
      "clientNumber": { "type": "string", "description": "Unique identifier for the client" },
      "issueDate": { "type": "string", "description": "Date the invoice was issued" },
      "page": { "type": "string", "description": "Page indicator in the header block" },
      "pageFooter": { "type": "string", "description": "Page number printed at the foot of the page" },
      "shipments": {
        "type": "array",
        "description": "Every shipment row printed in the table, in page order",
        "items": {
          "type": "object",
          "required": ["shipmentNumber"],
          "properties": {
            "shipmentNumber": { "type": "string" },
            "referenceNumber": { "type": ["string", "null"] },
            "date": { "type": "string" },
            "sender": {
              "type": "object",
              "properties": {
                "company": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "zipCode": { "type": "string" }
              }
            },
            "recipient": {
              "type": "object",
              "properties": {
                "company": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "zipCode": { "type": "string" }
              }
            },
            "typeOfService": { "type": "string" },
            "weightInKg": { "type": "number" },
            "numberOfShipments": { "type": "number" },
            "baseCharge": { "type": "number" },
            "additionalCharges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": { "type": "string" },
                  "amount": { "type": "number" },
                  "vat": { "type": "number", "description": "Value from the VAT / Code column" },
                  "grossValue": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "mostRecentShipment": {
        "type": "object",
        "required": ["shipmentNumber"],
        "description": "Shipment with the most recent date (closest to today's date), always the last item in the list",
        "properties": {
          "sender": {
            "type": "object",
            "required": ["company"],
            "properties": {
              "city": { "type": "string", "description": "City of the sender as it appears, excluding zip code" },
              "company": { "type": "string", "description": "Sender's company name as it appears" }
            }
          },
          "recipient": {
            "type": "object",
            "required": ["company"],
            "properties": {
              "address": { "type": "string", "description": "Street address of the recipient as it appears, only including number and street" },
              "company": { "type": "string", "description": "Recipient's company name as it appears" },
              "zipCode": { "type": "string", "description": "Zip code of the recipient as it appears" }
            }
          },
          "shipmentNumber": { "type": "string", "description": "Unique identifier for the shipment" },
          "additionalCharges": {
            "type": "array",
            "description": "Details of additional charges applied to the shipment",
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "amount": { "type": "number", "description": "Amount of the additional charge" },
                "totalVAT": { "type": "number", "description": "Total VAT applied to the additional charge" },
                "grossValue": { "type": "number", "description": "Gross value of the charge, including VAT" },
                "description": { "type": "string", "description": "Description of the additional charge as it appears" }
              }
            }
          }
        }
      }
    }
  },
