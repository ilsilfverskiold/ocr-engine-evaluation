  "doc_type": "shipping",
  "note": "The getomni schema keeps only the issue date and one shipment out of the six printed, and for that shipment records only the gross value of each surcharge, dropping the amount and VAT columns entirely. Extended with the header block (title, carrier, document number, client number, page) and a 'shipments' array: one object per printed row with shipment number, reference number, date, both parties split into company/address/city/zipCode, service type, weight, shipment count, base charge and every additional-charge line with all three of its money columns. The dataset's 'issueDate' and 'mostRecentShipment' are preserved unchanged; 'shipments[5]' is that shipment in full. All added values clear the one-third engine threshold except the document number. Judgement calls: (1) 'documentNumber' is '0ONSJC0OKP' — a deliberately nasty mixed zero/letter-O string; only 4 of 14 engines produce that exact sequence and the rest vary the O/0 assignment, but it matches the dataset's own text sidecar and the page, so it is kept and flagged as a hard field. (2) Reference number is blank on four rows and recorded as null. (3) Weight 18 on row four is printed without a decimal and is kept that way. (4) The table has several blank ruled rows below the last shipment; they carry no data and are not represented.",
  "extended_annotator": "claude-opus-5",
  "field_provenance": {
    "dataset_human": ["issueDate", "mostRecentShipment"],
    "model_verified": ["title", "carrier", "documentNumber", "clientNumber", "page", "pageFooter", "shipments"]
  },
  "json_schema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "description": "Document title as printed" },
      "carrier": { "type": "string", "description": "Carrier whose logo appears on the invoice" },
      "documentNumber": { "type": "string", "description": "Unique identifier for the invoice" },
      "clientNumber": { "type": "string", "description": "Unique identifier for the client" },
      "issueDate": { "type": "string", "description": "Date the invoice was issued" },
      "page": { "type": "string", "description": "Page indicator in the header block" },
      "pageFooter": { "type": "string", "description": "Page number printed at the foot of the page" },
      "shipments": {
        "type": "array",
        "description": "Every shipment row printed in the table, in page order",
        "items": {
          "type": "object",
          "required": ["shipmentNumber"],
          "properties": {
            "shipmentNumber": { "type": "string" },
            "referenceNumber": { "type": ["string", "null"] },
            "date": { "type": "string" },
            "sender": {
              "type": "object",
              "properties": {
                "company": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "zipCode": { "type": "string" }
              }
            },
            "recipient": {
              "type": "object",
              "properties": {
                "company": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "zipCode": { "type": "string" }
              }
            },
            "typeOfService": { "type": "string" },
            "weightInKg": { "type": "number" },
            "numberOfShipments": { "type": "number" },
            "baseCharge": { "type": "number" },
            "additionalCharges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["description"],
                "properties": {
                  "description": { "type": "string" },
                  "amount": { "type": "number" },
                  "vat": { "type": "number", "description": "Value from the VAT / Code column" },
                  "grossValue": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "mostRecentShipment": {
        "type": "object",
        "required": ["shipmentNumber"],
        "description": "Shipment with the most recent date (closest to today's date), always the last item in the list",
        "properties": {
          "sender": {
            "type": "object",
            "required": ["company"],
            "properties": {
              "company": { "type": "string", "description": "Sender's company name as it appears" }
            }
          },
          "recipient": {
            "type": "object",
            "required": ["company"],
            "properties": {
              "address": { "type": "string", "description": "Street address of the recipient as it appears, only including number and street" },
              "company": { "type": "string", "description": "Recipient's company name as it appears" },
              "zipCode": { "type": "string", "description": "Zip code of the recipient as it appears" }
            }
          },
          "weightInKg": { "type": "number", "description": "Weight of the shipment in kilograms" },
          "shipmentNumber": { "type": "string", "description": "Unique identifier for the shipment" },
          "referenceNumber": { "type": "string", "description": "Reference number for the shipment, must return null if not provided" },
          "additionalCharges": {
            "type": "array",
            "description": "Details of additional charges applied to the shipment",
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "grossValue": { "type": "number", "description": "Gross value of the charge, including VAT" },
                "description": { "type": "string", "description": "Description of the additional charge as it appears" }
              }
            }
          },
          "numberOfShipments": { "type": "number", "description": "Total number of shipments" }
        }
      }
    }
  },
