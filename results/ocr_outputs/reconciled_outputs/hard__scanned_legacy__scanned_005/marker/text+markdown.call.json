        ],
        "text": "<p block-type='ListGroup'><ul><content-ref src='/page/0/ListItem/8'></content-ref><content-ref src='/page/0/ListItem/9'></content-ref><content-ref src='/page/0/ListItem/10'></content-ref><content-ref src='/page/0/ListItem/11'></content-ref></ul></p>"
